# Never commit real credentials or personal data. Use a pooled PostgreSQL URL for the runtime.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sjsm_smart_roster
FIREBASE_PROJECT_ID=sjsm-smart-roster-dev
APP_ENV=development

# Required only for the conversational assistant (/api/v1/assistant/ask).
# Automated tests never call the real API; only production/dev traffic does.
# The free Gemini API tier is used for the Capstone demo only. Google's terms
# for the free tier permit using submitted content to improve their models;
# see docs/adr/0003-use-gemini-flash-lite-for-assistant-classification.md
# before sending any real member data or switching this to production.
GEMINI_API_KEY=
ASSISTANT_MODEL=gemini-3.1-flash-lite

# Signs short-lived confirmation tokens for conversational availability
# writes (prepare_mark_unavailable / confirm). Use a long random value in
# any real deployment; an empty value makes tokens trivially forgeable.
ASSISTANT_CONFIRMATION_SECRET=

# Required only for sending roster-published email notifications. Automated
# tests never call the real API; a missing key just makes real sends fail
# (recorded as a failed notification_deliveries row, not a crash).
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=notifications@sjsm-smart-roster.app
