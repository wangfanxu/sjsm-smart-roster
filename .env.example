# Never commit real credentials or personal data. Use a pooled PostgreSQL URL for the runtime.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sjsm_smart_roster
FIREBASE_PROJECT_ID=sjsm-smart-roster-dev
APP_ENV=development

# Firebase Web SDK config for the browser sign-in UI (UI-01). These values
# are not secret - they are meant to be public in client bundles; Firebase
# security comes from Auth + server-side authorization, not from hiding
# them. Get them from Firebase Console > Project settings > General > Your apps,
# or `firebase apps:sdkconfig WEB <appId>`. Google sign-in must be enabled
# under Authentication > Sign-in method in the Firebase Console first.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCWkzgozfVhtuUghhwGerZSMOD03-w4Jag
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sjsm-smart-roster.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sjsm-smart-roster
NEXT_PUBLIC_FIREBASE_APP_ID=1:931004635367:web:070f5bb1bb444226106a42

# Required only for the conversational assistant (/api/v1/assistant/ask).
# Automated tests never call the real API; only production/dev traffic does.
# The free Gemini API tier is used for the Capstone demo only. Google's terms
# for the free tier permit using submitted content to improve their models;
# see docs/adr/0003-use-gemini-flash-lite-for-assistant-classification.md
# before sending any real member data or switching this to production.
GEMINI_API_KEY=
ASSISTANT_MODEL=gemini-3.1-flash-lite

# Signs short-lived confirmation tokens for conversational availability
# writes (prepare_mark_unavailable / confirm). Use a long random value in
# any real deployment; an empty value makes tokens trivially forgeable.
ASSISTANT_CONFIRMATION_SECRET=

# Required only for sending roster-published email notifications. Automated
# tests never call the real API; a missing key just makes real sends fail
# (recorded as a failed notification_deliveries row, not a crash).
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=notifications@sjsm-smart-roster.app

# Required only to run `npm run provision:members <export-file-path>`
# (scripts/bulk-provision-members.mjs, see docs/legacy-migration-spike.md).
# ADMIN_EMAIL must be an existing administrator already linked to Firebase;
# the script mints a short-lived ID token for that account via Firebase
# Admin credentials (application-default credentials, same as the server's
# token verifier) - it never needs that admin's password. API_BASE_URL
# defaults to http://localhost:3000 if unset.
ADMIN_EMAIL=
API_BASE_URL=
